# Fabric SQL endpoint (Warehouse or Lakehouse SQL endpoint)
# Example: xxxxxxxx.datawarehouse.fabric.microsoft.com
FABRIC_SQL_ENDPOINT=your-endpoint.datawarehouse.fabric.microsoft.com
FABRIC_DATABASE=YourWarehouseOrLakehouseName

# Comma-separated list of tables in [schema.]table form. Leave empty to count ALL user tables.
FABRIC_TABLES=dbo.Customers,dbo.Orders

# Auth mode: "interactive" (browser popup) or "serviceprincipal"
AUTH_MODE=interactive

# Only required when AUTH_MODE=serviceprincipal
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Counting mode: "exact" runs SELECT COUNT_BIG(*) on each table (recommended; works on Fabric Warehouse).
# "fast" uses sys.partitions metadata - instant but returns 0 on Fabric Warehouse since stats aren't tracked.
COUNT_MODE=exact

# ---------------------------------------------------------------------------
# Dynamics 365 Finance & Operations comparison
# ---------------------------------------------------------------------------
# Base URI of the D365 F&O environment, e.g. https://yourenv.cloudax.dynamics.com
D365_URI=

# Auth mode for D365: "interactive" (browser popup) or "serviceprincipal"
D365_AUTH_MODE=interactive

# Only required when D365_AUTH_MODE=serviceprincipal
D365_TENANT_ID=
D365_CLIENT_ID=
D365_CLIENT_SECRET=

# Optional: explicit Fabric->D365 table name mapping, comma-separated pairs:
#   dbo.systemuser=USERINFO,dbo.bot=BOTTABLE
# When unmapped, the script uppercases the table name with schema stripped.
TABLE_NAME_MAP=

# Optional: skip the D365 comparison and only show Fabric counts (true/false)
SKIP_D365=false

# D365 FabricHelperService version:
#   v3 = getTableRowCounts (bulk, catalog-based, one call for all tables) + getTableMetadata (default, fastest)
#   v1 = getTableRecordCount   (Direct SQL query - faster, per-table)
#   v2 = getTableRecordCountV2 (X++ query - identical to Fabric Link, per-table)
D365_SERVICE_VERSION=v3

# HTML/CSV report output paths.A timestamp is automatically inserted before
# the extension on each run, e.g. report.html -> report_20260429_174400.html.
# Leave empty to skip that format.
HTML_REPORT=report.html
HTML_OPEN=true
CSV_REPORT=report.csv

